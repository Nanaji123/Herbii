{
  "expo": {
    "name": "Herbii - Herb Identifier & Helper",
    "slug": "HerbiiIdentifier",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "herbiiidentifier",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.herbii.identifier"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#061E0E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.herbii.identifier"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#061E0E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1F6B43"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Herbii uses the camera to photograph plants so they can be identified.",
          "photosPermission": "Herbii lets you pick plant photos to identify."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Herbii uses the camera to scan plants so they can be identified.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
